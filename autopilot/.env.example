# gtec0.github.io autopilot — post-ONLY edition (you share manually).
# Copy this file to .env — only GEMINI_API_KEY is really worth setting
# (free from https://aistudio.google.com). Everything else works with
# zero keys in fallback mode. No social/automation secrets needed.

# --- AI text (pick one, free tier). Leave empty to use built-in template engine ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional free alternatives:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- Images: Pollinations legacy free URL needs NO key. Leave blank = free mode ---
# If Pollinations ever blocks CI, the Pillow fallback banner always works offline.
POLLINATIONS_MODEL=flux
NO_AI_IMAGES=0

# --- Blog location ---
# Local run: path to your beautiful-jekyll checkout (gtec0.github.io repo)
# In GitHub Actions this is the repo itself, so leave as .
BLOG_REPO=.
BLOG_URL=https://gtec0.github.io
POSTS_DIR=_posts
BANNERS_DIR=assets/images/banners
